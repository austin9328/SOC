
#include "xparameters.h"
#include "xuartps.h"
#include "xil_printf.h"
#include "xil_io.h"

// AXI base address for your custom IP
#define BASEADDR XPAR_FINAL_0_S00_AXI_BASEADDR

// slv_reg offset 定義
#define SLV_REG0_OFFSET 0x00
#define SLV_REG1_OFFSET 0x04
#define SLV_REG2_OFFSET 0x08
#define SLV_REG3_OFFSET 0x0C

#define UART0_DEVICE_ID XPAR_XUARTPS_0_DEVICE_ID  // Raspberry Pi
#define UART1_DEVICE_ID XPAR_XUARTPS_1_DEVICE_ID  // SDK terminal

XUartPs Uart0, Uart1;

int init_my_uart(XUartPs *InstancePtr, u16 DeviceId) {
    XUartPs_Config *Config;
    int Status;

    Config = XUartPs_LookupConfig(DeviceId);
    if (NULL == Config) return XST_FAILURE;

    Status = XUartPs_CfgInitialize(InstancePtr, Config, Config->BaseAddress);
    if (Status != XST_SUCCESS) return XST_FAILURE;

    XUartPs_SetBaudRate(InstancePtr, 115200);
    return XST_SUCCESS;
}

int main() {
    u8 recv_char;
    int status;

    static u8 prev_score = 0xFF;  // 初始化為不可能的值

    // 初始化 UARTs
    status = init_my_uart(&Uart0, UART0_DEVICE_ID);
    if (status != XST_SUCCESS) {
        xil_printf("UART0 init failed\n");
        return -1;
    }

    status = init_my_uart(&Uart1, UART1_DEVICE_ID);
    if (status != XST_SUCCESS) {
        xil_printf("UART1 init failed\n");
        return -1;
    }

    xil_printf("Both UARTs initialized!\n");

    while (1) {
        // 等待從 SDK Terminal 收到資料
        if (XUartPs_IsReceiveData(Uart1.Config.BaseAddress)) {
            recv_char = XUartPs_RecvByte(Uart1.Config.BaseAddress);

            // 啟動傳輸模式
            if (recv_char == 'S') {

        	    Xil_Out32(BASEADDR+SLV_REG0_OFFSET,0x00000100);
        	    Xil_Out32(BASEADDR+SLV_REG0_OFFSET,0x00000000);
                xil_printf("Received 'S' from SDK. Starting data transfer...\n");

                // 發送 'S' 給 Raspberry Pi
                XUartPs_SendByte(Uart0.Config.BaseAddress, 'S');

                // 開始接收資料
                while (1) {
                    while (!XUartPs_IsReceiveData(Uart0.Config.BaseAddress)) {
                        // 等待
                    }
                    u32 slv_reg1 = Xil_In32(BASEADDR + SLV_REG1_OFFSET);
                    u8 score = slv_reg1 & 0xF;
                    if(score != prev_score){
                    	prev_score = score;
                    	 // 傳送分數
                    	char score_buf[4];
                        int score_len = print(score_buf, "%u", score);
                   	    XUartPs_SendByte(Uart0.Config.BaseAddress, 'p');
                   	    for (int i = 0; i < score_len; i++) {
                   	        XUartPs_SendByte(Uart0.Config.BaseAddress, score_buf[i]);
                   	    }
                    	    // 簡單延遲，避免重複傳送
                   	    for (volatile int i = 0; i < 100000000; i++);  // 延遲迴圈
                    }
                    u8 pi_data = XUartPs_RecvByte(Uart0.Config.BaseAddress);
                    xil_printf("Received from Pi: %c (0x%02X)\n", pi_data, pi_data);

                    if (pi_data == '0' || pi_data == '1') {
                        u32 value = (pi_data == '1') ? 1 : 0;
                        Xil_Out32(BASEADDR + SLV_REG0_OFFSET, value);
                        xil_printf("Written %d to slv_reg0\n", value);
                    }
                    else if (pi_data == 'D') {
                        xil_printf("Received 'D' from Pi. Ending transfer.\n");
                	    Xil_Out32(BASEADDR+SLV_REG0_OFFSET,0x00000200);
                	    Xil_Out32(BASEADDR+SLV_REG0_OFFSET,0x00000000);
                        break;
                    }
                }

            } else if (recv_char == 'T') {
                // DEBUG 模式：雙向資料傳輸
                xil_printf("Entered DEBUG mode. Press 'Q' to quit.\n");
                while (1) {
                    // SDK → Pi
                    if (XUartPs_IsReceiveData(Uart1.Config.BaseAddress)) {
                        u8 dbg_send = XUartPs_RecvByte(Uart1.Config.BaseAddress);

                        if (dbg_send == 'Q') {
                            xil_printf("Exiting DEBUG mode.\n");
                            break;
                        }

                        XUartPs_SendByte(Uart0.Config.BaseAddress, dbg_send);
                        xil_printf("Sent to Pi: %c (0x%02X)\n", dbg_send, dbg_send);
                    }

                    // Pi → SDK
                    if (XUartPs_IsReceiveData(Uart0.Config.BaseAddress)) {
                        u8 dbg_recv = XUartPs_RecvByte(Uart0.Config.BaseAddress);
                        xil_printf("Received from Pi: %c (0x%02X)\n", dbg_recv, dbg_recv);
                    }
                }
            }
        }
    }

    return 0;
}

