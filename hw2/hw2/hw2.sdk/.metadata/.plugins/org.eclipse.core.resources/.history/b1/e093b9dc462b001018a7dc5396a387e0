/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "xparameters.h"
#include "xscugic.h"
#include "xil_exception.h"
#include "xil_printf.h"
#include "xil_io.h"

// 中斷控制器相關
#define GIC_DEVICE_ID      XPAR_PS7_SCUGIC_0_DEVICE_ID
#define IRQ_NUM            XPAR_FABRIC_HW2_0_IRQ_INTR

// AXI IP Base Addr
#define HW2_BASEADDR       XPAR_HW2_0_S00_AXI_BASEADDR

// Register Offset
#define REG0_OFFSET        0x00  // slv_reg0: 控制啟動
#define REG1_OFFSET        0x04  // slv_reg1: 回傳 led_index

// 宣告中斷控制器物件
static XScuGic Intc;

// 中斷旗標
volatile int IntrFlag = 0;

// ISR 函式
void HW2_IntrHandler(void *CallbackRef)
{
    u32 led_index;

    // 清除中斷旗標 (PL 側自動處理, 若需要清除 pending，這裡加上)
    IntrFlag = 1;

    // 讀取 led_index
    led_index = Xil_In32(HW2_BASEADDR + REG1_OFFSET);

    xil_printf("[ISR] Interrupt received! led_index = %d\r\n", led_index);
}

// 初始化中斷
int SetupInterruptSystem(XScuGic *IntcInstancePtr)
{
    XScuGic_Config *IntcConfig;
    int Status;

    // 初始化中斷控制器
    IntcConfig = XScuGic_LookupConfig(GIC_DEVICE_ID);
    if (NULL == IntcConfig) {
        return XST_FAILURE;
    }

    Status = XScuGic_CfgInitialize(IntcInstancePtr, IntcConfig, IntcConfig->CpuBaseAddress);
    if (Status != XST_SUCCESS) {
        return XST_FAILURE;
    }

    // 設定中斷觸發類型 (邊緣 / 電平)
    XScuGic_SetPriorityTriggerType(IntcInstancePtr, IRQ_NUM, 0xA0, 0x3);  // 0x3 = Rising Edge

    // 連接 ISR
    Status = XScuGic_Connect(IntcInstancePtr, IRQ_NUM, (Xil_InterruptHandler)HW2_IntrHandler, NULL);
    if (Status != XST_SUCCESS) {
        return XST_FAILURE;
    }

    // 啟用中斷來源
    XScuGic_Enable(IntcInstancePtr, IRQ_NUM);

    // 啟用 CPU 中斷
    Xil_ExceptionInit();
    Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT, (Xil_ExceptionHandler)XScuGic_InterruptHandler, IntcInstancePtr);
    Xil_ExceptionEnable();

    return XST_SUCCESS;
}

// 主程式
int main()
{
    int Status;
    u32 data;

    xil_printf("---- HW2 Interrupt Test Start ----\r\n");

    // 初始化中斷系統
    Status = SetupInterruptSystem(&Intc);
    if (Status != XST_SUCCESS) {
        xil_printf("Interrupt system setup failed!\r\n");
        return XST_FAILURE;
    }
    xil_printf("Interrupt system setup done.\r\n");

    // 啟動硬體 (寫 slv_reg0 bit0 = 1)
    xil_printf("Triggering HW2 by writing 1 to slv_reg0...\r\n");
    Xil_Out32(HW2_BASEADDR + REG0_OFFSET, 0x1);
    xil_print("111")
    while (1)
    {
        if (IntrFlag) {
            xil_printf("Main loop detected interrupt.\r\n");
            IntrFlag = 0;  // 重置旗標

            // 這裡可以再做更多事情
        }
    }

    return 0;
}
