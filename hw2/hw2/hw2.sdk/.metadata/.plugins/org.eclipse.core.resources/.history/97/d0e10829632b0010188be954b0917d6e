/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "xparameters.h"
#include "xscugic.h"
#include "xil_exception.h"
#include "xil_printf.h"
#include "xil_io.h"
#include "sleep.h"
#include "xuartps.h"

// Define IP Base Address
#define HW2_BASEADDR   XPAR_HW2_0_S00_AXI_BASEADDR

// Register Offset
#define REG0_OFFSET    0x00  // Start trigger
#define REG1_OFFSET    0x04  // Read led_index

// Interrupt related
#define GIC_DEVICE_ID  XPAR_PS7_SCUGIC_0_DEVICE_ID
#define IRQ_NUM        XPAR_FABRIC_HW2_0_IRQ_INTR

XScuGic Intc;
volatile int IntrFlag = 0;
volatile int StopFlag = 0;   // Flag to stop the running pattern

// ISR function (hardware interrupt)
void HW2_ISR(void *CallbackRef)
{
    u32 led_index = Xil_In32(HW2_BASEADDR + REG1_OFFSET);
    xil_printf("[ISR] Hardware interrupt triggered! LED index: %d\r\n", led_index);
    IntrFlag = 1;
    StopFlag = 1;  // Set stop flag
}

// Initialize interrupt system
int SetupInterruptSystem()
{
    XScuGic_Config *IntcConfig;
    int Status;

    IntcConfig = XScuGic_LookupConfig(GIC_DEVICE_ID);
    if (NULL == IntcConfig)
        return XST_FAILURE;

    Status = XScuGic_CfgInitialize(&Intc, IntcConfig, IntcConfig->CpuBaseAddress);
    if (Status != XST_SUCCESS)
        return XST_FAILURE;

    // Set IRQ to rising edge trigger
    XScuGic_SetPriorityTriggerType(&Intc, IRQ_NUM, 0xA0, 0x3);  // 0x3 = Rising Edge

    // Connect ISR
    Status = XScuGic_Connect(&Intc, IRQ_NUM, (Xil_InterruptHandler)HW2_ISR, NULL);
    if (Status != XST_SUCCESS)
        return XST_FAILURE;

    XScuGic_Enable(&Intc, IRQ_NUM);

    Xil_ExceptionInit();
    Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT,
                                 (Xil_ExceptionHandler)XScuGic_InterruptHandler,
                                 &Intc);
    Xil_ExceptionEnable();

    return XST_SUCCESS;
}

// Check UART input (software interrupt)
int CheckUartInput()
{
    if (XUartPs_IsReceiveData(STDIN_BASEADDRESS)) {
        char c = getchar();  // Read input character
        xil_printf("[UART] Received input: %c ¡÷ Software interrupt triggered, stopping LED pattern\r\n", c);
        return 1;
    }
    return 0;
}

// Main function
int main()
{
    int Status;
    xil_printf("==== HW2 SDK: Running LED Pattern + Interrupt Demo ====\r\n");

    // Initialize interrupt
    Status = SetupInterruptSystem();
    if (Status != XST_SUCCESS) {
        xil_printf("Interrupt system initialization failed!\r\n");
        return XST_FAILURE;
    }
    xil_printf("Interrupt system initialized successfully.\r\n");

    xil_printf("Starting LED running pattern. (Press button or type any key to stop)\r\n");

    while (1) {
        if (!StopFlag) {
            // Continuously send start signal to keep LEDs running
            Xil_Out32(HW2_BASEADDR + REG0_OFFSET, 1);
            usleep(100000);  // 100ms high pulse
            Xil_Out32(HW2_BASEADDR + REG0_OFFSET, 0);
            usleep(400000);  // 0.5s interval
        } else {
            xil_printf("LED pattern stopped (interrupt triggered).\r\n");
            while (1) {
                // Wait forever after stopping
                sleep(1);
            }
        }

        // Check for UART input (software interrupt)
        if (CheckUartInput()) {
            StopFlag = 1;
        }
    }
    return 0;
}


