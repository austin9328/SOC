/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include "xparameters.h"
#include "xuartps.h"
#include "xil_printf.h"
#include "sleep.h"

// UART0: 顯示 log 到 terminal (MIO14/15)
#define UART0_DEVICE_ID XPAR_XUARTPS_1_DEVICE_ID

// UART1: 用 EMIO 傳字元到 PL uart_rx IP
#define UART1_DEVICE_ID XPAR_XUARTPS_0_DEVICE_ID

XUartPs Uart0, Uart1;

int main() {
    int Status;
    u8 tx_byte = '3';

    xil_printf("===== UART 雙通道測試開始 =====\r\n");

    // 初始化 UART0（MIO14 → Terminal）
    XUartPs_Config *Config0 = XUartPs_LookupConfig(UART0_DEVICE_ID);
    if (Config0 == NULL) return XST_FAILURE;

    Status = XUartPs_CfgInitialize(&Uart0, Config0, Config0->BaseAddress);
    if (Status != XST_SUCCESS) return XST_FAILURE;

    XUartPs_SetBaudRate(&Uart0, 115200);
    XUartPs_Send(&Uart0, (u8*)"UART0 初始化完成\r\n", 18);

    // 初始化 UART1（EMIO → 傳給 PL）
    XUartPs_Config *Config1 = XUartPs_LookupConfig(UART1_DEVICE_ID);
    if (Config1 == NULL) return XST_FAILURE;

    Status = XUartPs_CfgInitialize(&Uart1, Config1, Config1->BaseAddress);
    if (Status != XST_SUCCESS) return XST_FAILURE;

    XUartPs_SetBaudRate(&Uart1, 115200);
    XUartPs_Send(&Uart0, (u8*)"UART1 初始化完成 (EMIO)\r\n", 26);

    // 傳送字元 '3' 給 PL 端
    xil_printf("傳送字元 '%c' (0x%02X) 給 PL...\r\n", tx_byte, tx_byte);
    XUartPs_Send(&Uart1, &tx_byte, 1);

    xil_printf("等待顯示結果中...\r\n");

    while (1);
    return 0;
}
