/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include "xparameters.h"
#include "xuartps.h"
#include "xil_printf.h"
#include "sleep.h"

#define UART_DEVICE_ID XPAR_XUARTPS_0_DEVICE_ID


XUartPs Uart_Ps;

int main() {
    int Status;

    xil_printf("ZYNQ UART1 → PL UART_RX 測試開始...\r\n");

    // 取得 UART1 設定
    XUartPs_Config *Config = XUartPs_LookupConfig(UART_DEVICE_ID);
    if (Config == NULL) {
        xil_printf("找不到 UART1 設定\r\n");
        return XST_FAILURE;
    }

    // 初始化 UART1
    Status = XUartPs_CfgInitialize(&Uart_Ps, Config, Config->BaseAddress);
    if (Status != XST_SUCCESS) {
        xil_printf("UART1 初始化失敗\r\n");
        return XST_FAILURE;
    }

    // 設定 baud rate 為 115200
    XUartPs_SetBaudRate(&Uart_Ps, 115200);

    // 發送字元 '3'（0x33）給 PL 的 uart_rx
    u8 ch = '3';
    XUartPs_Send(&Uart_Ps, &ch, 1);

    xil_printf("已送出字元: %c (0x%02X)\r\n", ch, ch);

    // 可反覆傳送
    while (1) {
        sleep(1);
        XUartPs_Send(&Uart_Ps, &ch, 1);
        xil_printf("每秒送出: %c\r\n", ch);
    }

    return 0;
}
