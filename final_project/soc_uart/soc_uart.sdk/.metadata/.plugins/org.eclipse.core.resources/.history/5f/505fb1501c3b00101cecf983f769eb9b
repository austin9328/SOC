/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include "xparameters.h"
#include "xuartps.h"
#include "sleep.h"

#define UART1_DEVICE_ID XPAR_XUARTPS_1_DEVICE_ID  // 對應 UART1（EMIO）

XUartPs Uart1;

int main() {
    int Status;
    u8 tx_byte;

    // 初始化 UART1
    XUartPs_Config *Config = XUartPs_LookupConfig(UART1_DEVICE_ID);
    if (Config == NULL)
        return XST_FAILURE;

    Status = XUartPs_CfgInitialize(&Uart1, Config, Config->BaseAddress);
    if (Status != XST_SUCCESS)
        return XST_FAILURE;

    XUartPs_SetBaudRate(&Uart1, 115200);  // 與 PL 的 prescale 設定匹配

    // 傳送 '0' 到 '9'
    for (tx_byte = '0'; tx_byte <= '9'; tx_byte++) {
        XUartPs_Send(&Uart1, &tx_byte, 1);
        usleep(500000);  // 每 0.5 秒送一個字元，給 PL 反應時間
    }

    while (1);  // 無限等待（PL 端處理顯示）
    return 0;
}
