/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "xparameters.h"
#include "xscugic.h"
#include "xil_exception.h"
#include "xil_printf.h"
#include "xil_io.h"
#include "sleep.h"

// 定義 IP Base Address
#define HW2_BASEADDR   XPAR_HW2_0_S00_AXI_BASEADDR

// 定義 Register Offset
#define REG0_OFFSET    0x00  // 觸發
#define REG1_OFFSET    0x04  // 讀回 led_index

// 中斷相關
#define GIC_DEVICE_ID  XPAR_PS7_SCUGIC_0_DEVICE_ID
#define IRQ_NUM        XPAR_FABRIC_HW2_0_IRQ_INTR

XScuGic Intc;
volatile int IntrFlag = 0;

// ISR 函式
void HW2_ISR(void *CallbackRef)
{
    u32 led_index = Xil_In32(HW2_BASEADDR + REG1_OFFSET);
    xil_printf("[ISR] Interrupt received! LED index: %d\r\n", led_index);
    IntrFlag = 1;
}

// 初始化中斷系統
int SetupInterruptSystem()
{
    XScuGic_Config *IntcConfig;
    int Status;

    IntcConfig = XScuGic_LookupConfig(GIC_DEVICE_ID);
    if (NULL == IntcConfig)
        return XST_FAILURE;

    Status = XScuGic_CfgInitialize(&Intc, IntcConfig, IntcConfig->CpuBaseAddress);
    if (Status != XST_SUCCESS)
        return XST_FAILURE;

    // 設定 IRQ 為上升沿觸發
    XScuGic_SetPriorityTriggerType(&Intc, IRQ_NUM, 0xA0, 0x3);  // 0x3 = Rising Edge

    // 綁定 ISR
    Status = XScuGic_Connect(&Intc, IRQ_NUM, (Xil_InterruptHandler)HW2_ISR, NULL);
    if (Status != XST_SUCCESS)
        return XST_FAILURE;

    XScuGic_Enable(&Intc, IRQ_NUM);

    Xil_ExceptionInit();
    Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT,
                                 (Xil_ExceptionHandler)XScuGic_InterruptHandler,
                                 &Intc);
    Xil_ExceptionEnable();

    return XST_SUCCESS;
}

// 主程式
int main()
{
    int Status;
    xil_printf("==== HW2 SDK Program Start ====\r\n");

    Status = SetupInterruptSystem();
    if (Status != XST_SUCCESS) {
        xil_printf("Interrupt system setup failed.\r\n");
        return XST_FAILURE;
    }
    xil_printf("Interrupt system ready.\r\n");

    while (1) {
        xil_printf("Triggering LED shift...\r\n");
        Xil_Out32(HW2_BASEADDR + REG0_OFFSET, 0);  // 觸發硬體
        // 等待中斷完成
        while (!IntrFlag);
        IntrFlag = 0;  // 重置

        sleep(2);  // 延遲 2 秒
    }

    return 0;
}
