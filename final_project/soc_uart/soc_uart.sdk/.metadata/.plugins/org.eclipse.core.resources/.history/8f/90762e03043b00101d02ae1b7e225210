/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include "xparameters.h"
#include "xuartps.h"
#include "xil_printf.h"
#include "sleep.h"

#define UART_DEVICE_ID XPAR_XUARTPS_0_DEVICE_ID  // UART1 (EMIO) 在 xparameters.h 對應到 ID 0

XUartPs UartPs;

int main() {
    int Status;

    xil_printf("==== ZYNQ UART1 → PL uart_rx 傳送測試 ====\r\n");

    // 取得 UART 配置
    XUartPs_Config *Config = XUartPs_LookupConfig(UART_DEVICE_ID);
    if (Config == NULL) {
        xil_printf("找不到 UART 配置\r\n");
        return XST_FAILURE;
    }

    // 初始化 UART
    Status = XUartPs_CfgInitialize(&UartPs, Config, Config->BaseAddress);
    if (Status != XST_SUCCESS) {
        xil_printf("UART 初始化失敗\r\n");
        return XST_FAILURE;
    }

    // 設定 Baud Rate
    XUartPs_SetBaudRate(&UartPs, 115200);

    // 發送 ASCII 字元 '3' (0x33)
    u8 ch = '3';
    xil_printf("傳送字元: %c (0x%02X)\r\n", ch, ch);
    XUartPs_Send(&UartPs, &ch, 1);

    // 等待回應（可略過）
    sleep(1);
    xil_printf("完成傳送。\r\n");

    while (1);
    return 0;
}
