#include "xparameters.h"
#include "xuartps.h"
#include "xil_printf.h"

#define UART0_DEVICE_ID XPAR_XUARTPS_0_DEVICE_ID  // 樹梅派
#define UART1_DEVICE_ID XPAR_XUARTPS_1_DEVICE_ID  // SDK terminal
#define SLV_REG_BASEADDR XPAR_FINAL_0_S00_AXI_BASEADDR  // AXI Slave register

XUartPs Uart0, Uart1;

// 初始化 UART
int init_my_uart(XUartPs *InstancePtr, u16 DeviceId) {
    XUartPs_Config *Config;
    int Status;

    Config = XUartPs_LookupConfig(DeviceId);
    if (NULL == Config) return XST_FAILURE;

    Status = XUartPs_CfgInitialize(InstancePtr, Config, Config->BaseAddress);
    if (Status != XST_SUCCESS) return XST_FAILURE;

    XUartPs_SetBaudRate(InstancePtr, 115200);
    return XST_SUCCESS;
}

// 寫入 AXI 寄存器
void write_slv_reg(u32 value) {
    *(volatile u32 *)SLV_REG_BASEADDR = value;
}

// 讀取 AXI 寄存器
u32 read_slv_reg() {
    return *(volatile u32 *)SLV_REG_BASEADDR;
}

int main() {
    u8 recv_char;
    int status;
    u32 slv_reg = 0;
    u32 slv_reg_prev = 0;
    u32 slv_reg_curr;

    // 初始化 UART0
    status = init_my_uart(&Uart0, UART0_DEVICE_ID);
    if (status != XST_SUCCESS) {
        xil_printf("UART0 init failed\n");
        return -1;
    }

    // 初始化 UART1
    status = init_my_uart(&Uart1, UART1_DEVICE_ID);
    if (status != XST_SUCCESS) {
        xil_printf("UART1 init failed\n");
        return -1;
    }

    xil_printf("Both UARTs initialized!\n");

    while (1) {
        // 檢查 slv_reg[4] 是否為 1
        slv_reg_curr = read_slv_reg();
        if ((slv_reg_curr & (1 << 4)) && !(slv_reg_prev & (1 << 4))) {
        	print("start");
            const char *msg = "start";
            for (int i = 0; msg[i]; i++)
                XUartPs_SendByte(Uart0.Config.BaseAddress, msg[i]); // 傳送到樹梅派
            xil_printf("Sent 'start' to UART0\n");
        }

        // 檢查 slv_reg[3:0] 是否改變
        if ((slv_reg_curr & 0xF) != (slv_reg_prev & 0xF)) {
            xil_printf("Score: %d\n", slv_reg_curr & 0xF); // 顯示到 SDK
            char score = (slv_reg_curr & 0xF) + '0';
            XUartPs_SendByte(Uart0.Config.BaseAddress, score); // 傳送到樹梅派
        }
        slv_reg_prev = slv_reg_curr;

        // 檢查樹梅派傳來的資料
        if (XUartPs_IsReceiveData(Uart0.Config.BaseAddress)) {
            recv_char = XUartPs_RecvByte(Uart0.Config.BaseAddress);

            if (recv_char == '0' || recv_char == '1') {
                slv_reg = (slv_reg & ~1) | (recv_char - '0'); // 設置 slv_reg[0]
                write_slv_reg(slv_reg);
                xil_printf("Received %c, set slv_reg[0] = %c\n", recv_char, recv_char);
            } else if (recv_char == 'd') { // 假設 'done' 以 'd' 代表
                slv_reg |= (1 << 8); // 設置 slv_reg[8] = 1
                write_slv_reg(slv_reg);
                xil_printf("Received 'done', set slv_reg[8] = 1, exiting\n");
                break;
            }
        }
    }

    return 0;
}
